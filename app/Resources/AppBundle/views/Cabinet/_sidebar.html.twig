<aside class="cabinet-sidebar">
    <nav class="cabinet-nav">
        <a href="{{ path('cabinet') }}"
           class="cabinet-nav__item{% if app.request.attributes.get('_route') == 'cabinet' %} cabinet-nav__item--active{% endif %}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
                <rect x="9" y="3" width="6" height="4" rx="1"/>
                <path d="M9 12h6M9 16h4"/>
            </svg>
            {{ 'frontend.cabinet.orders_title'|trans([], 'AppBundle') }}
        </a>
        <a href="{{ path('cabinet_profile') }}"
           class="cabinet-nav__item{% if app.request.attributes.get('_route') == 'cabinet_profile' %} cabinet-nav__item--active{% endif %}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            </svg>
            {{ 'frontend.cabinet.profile_title'|trans([], 'AppBundle') }}
        </a>
        <a href="{{ path('cabinet_favorites') }}"
           class="cabinet-nav__item{% if app.request.attributes.get('_route') == 'cabinet_favorites' %} cabinet-nav__item--active{% endif %}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            {{ 'frontend.cabinet.favorites_title'|trans([], 'AppBundle') }}
        </a>
        <a href="{{ path('cabinet_addresses') }}"
           class="cabinet-nav__item{% if app.request.attributes.get('_route') in ['cabinet_addresses', 'cabinet_address_default', 'cabinet_address_delete'] %} cabinet-nav__item--active{% endif %}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 21s6-4.35 6-10a6 6 0 1 0-12 0c0 5.65 6 10 6 10z"/>
                <circle cx="12" cy="11" r="2.5"/>
            </svg>
            {{ 'frontend.cabinet.addresses_title'|trans([], 'AppBundle') }}
        </a>
    </nav>
    <div class="cabinet-sidebar__footer">
        <a href="{{ path('logout') }}" class="cabinet-logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            {{ 'frontend.cabinet.logout'|trans([], 'AppBundle') }}
        </a>
    </div>
</aside>

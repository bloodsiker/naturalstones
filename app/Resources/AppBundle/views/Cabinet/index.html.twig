<section class="simple-section">
    <div class="container">

        <h1>{{ 'frontend.cabinet.title'|trans([], 'AppBundle') }}</h1>

        <div class="cabinet-layout">

            {{ include('@App/Cabinet/_sidebar.html.twig') }}

            <div class="cabinet-content">
                <div class="cabinet-card">
                    <div class="cabinet-card__title">{{ 'frontend.cabinet.orders_title'|trans([], 'AppBundle') }}</div>
                    {% if orders is empty %}
                        <div class="cabinet-empty">{{ 'frontend.cabinet.no_orders'|trans([], 'AppBundle') }}</div>
                    {% else %}
                        <div class="cabinet-orders-cards">
                            {% for order in orders %}
                                <article class="cabinet-order-card">
                                    <div class="cabinet-order-card__header">
                                        <div class="cabinet-order-card__heading">
                                            <div class="cabinet-order-card__number">{{ 'frontend.cabinet.order_id'|trans([], 'AppBundle') }} #{{ order.id }}</div>
                                            <div class="cabinet-order-card__date">{{ order.createdAt|date('d.m.Y H:i') }}</div>
                                        </div>
                                        <span class="cabinet-orders-status cabinet-orders-status--{{ order.status }}">
                                            {% if order.status == 1 %}{{ 'frontend.cabinet.status_new'|trans([], 'AppBundle') }}
                                            {% elseif order.status == 2 %}{{ 'frontend.cabinet.status_completed'|trans([], 'AppBundle') }}
                                            {% else %}{{ 'frontend.cabinet.status_cancelled'|trans([], 'AppBundle') }}{% endif %}
                                        </span>
                                    </div>
                                    <div class="cabinet-order-card__body">
                                        <div class="cabinet-order-card__meta">
                                            <span>{{ 'frontend.cabinet.order_sum'|trans([], 'AppBundle') }}</span>
                                            <strong>{{ order.orderSum|number_format(2, ',', ' ') }} грн</strong>
                                        </div>
                                        <div class="cabinet-order-card__meta">
                                            <span>{{ 'frontend.cabinet.items_count'|trans([], 'AppBundle') }}</span>
                                            <strong>{{ order.orderHasItems|length }}</strong>
                                        </div>
                                    </div>
                                    <div class="cabinet-order-card__actions">
                                        <a href="{{ path('cabinet_order_show', {'secret': order.secret}) }}" class="button cabinet-order-card__button">
                                            {{ 'frontend.cabinet.view_order'|trans([], 'AppBundle') }}
                                        </a>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>

    </div>
</section>

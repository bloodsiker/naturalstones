<section class="simple-section">
    <div class="container">

        <h1>{{ 'frontend.cabinet.title'|trans([], 'AppBundle') }}</h1>

        <div class="cabinet-layout">

            {{ include('@App/Cabinet/_sidebar.html.twig') }}

            <div class="cabinet-content">
                <div class="cabinet-card">
                    <div class="cabinet-card__title">{{ 'frontend.cabinet.profile_title'|trans([], 'AppBundle') }}</div>

                    {% if saved %}
                        <div class="cabinet-alert cabinet-alert--success">{{ 'frontend.cabinet.profile.saved'|trans([], 'AppBundle') }}</div>
                    {% endif %}

                    {% if error %}
                        <div class="cabinet-alert cabinet-alert--error">{{ error|trans([], 'AppBundle') }}</div>
                    {% endif %}

                    <form method="post" action="{{ path('cabinet_profile') }}" class="cabinet-form">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile') }}">

                        <div class="cabinet-form__row">
                            <div class="cabinet-form__field">
                                <label class="cabinet-form__label" for="profile_firstname">{{ 'frontend.cabinet.profile.firstname'|trans([], 'AppBundle') }}</label>
                                <input class="cabinet-form__input" id="profile_firstname" type="text" name="firstname"
                                       value="{{ user.firstname }}" autocomplete="given-name">
                            </div>
                            <div class="cabinet-form__field">
                                <label class="cabinet-form__label" for="profile_lastname">{{ 'frontend.cabinet.profile.lastname'|trans([], 'AppBundle') }}</label>
                                <input class="cabinet-form__input" id="profile_lastname" type="text" name="lastname"
                                       value="{{ user.lastname }}" autocomplete="family-name">
                            </div>
                        </div>

                        <div class="cabinet-form__row">
                            <div class="cabinet-form__field">
                                <label class="cabinet-form__label" for="profile_phone">{{ 'frontend.cabinet.profile.phone'|trans([], 'AppBundle') }}</label>
                                <input class="cabinet-form__input phone-input" id="profile_phone" type="tel" name="phone"
                                       value="{{ user.phone }}" autocomplete="tel">
                            </div>
                            <div class="cabinet-form__field">
                                <label class="cabinet-form__label">{{ 'frontend.cabinet.email_label'|trans([], 'AppBundle') }}</label>
                                <input class="cabinet-form__input cabinet-form__input--readonly" type="email"
                                       value="{{ user.email }}" readonly>
                            </div>
                        </div>

                        <button class="button cabinet-form__submit" type="submit">{{ 'frontend.cabinet.profile.save'|trans([], 'AppBundle') }}</button>
                    </form>
                </div>
            </div>

        </div>

    </div>
</section>
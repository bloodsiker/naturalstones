{% macro comment(comment, show_title = true) %}
    {% apply spaceless %}
        <div class="comment-item">
            <div class="comment-rating">
                <div class="comment-user">
                    <span>{{ comment.user ? comment.user.username : comment.userName }}</span>
                </div>
                <div class="stars">
                    <i class="active"></i>
                    <i class="active"></i>
                    <i class="active"></i>
                    <i class="active"></i>
                    <i class="active"></i>
                </div>
            </div>
            <div class="comment-product">
                <a href="{{ product_path(comment.product) }}">{{ comment.product.name }}</a>
            </div>
            <div class="comment">
                {{ comment.comment|raw }}
            </div>
        </div>
    {% endapply %}
{% endmacro %}

{% macro pageComment(comment, show_title = true) %}
    {% apply spaceless %}
        <div class="page-comment-item">
            <div class="comment-block-product">
                <a href="{{ product_path(comment.product) }}" class="comment-product-image">
                    <img class="lazyload" data-src="{{ asset(comment.product.image.path) }}" src="" alt="{{ comment.product.name }}">
                </a>
            </div>
            <div class="comment-content">
                <div class="page-comment-product">
                    <a href="{{ product_path(comment.product) }}">{{ comment.product.name }}</a>
                </div>
                <div class="page-comment-rating">
                    <div class="page-comment-user">
                        <span>{{ comment.user ? comment.user.username : comment.userName }}</span>
                    </div>
                    <div class="stars">
                        <i class="active"></i>
                        <i class="active"></i>
                        <i class="active"></i>
                        <i class="active"></i>
                        <i class="active"></i>
                    </div>
                </div>
                <div class="comment">
                    {{ comment.comment|raw }}
                </div>
            </div>
        </div>
    {% endapply %}
{% endmacro %}

{% import "CommentBundle:Block/macros:item.html.twig" as item %}

<div class="reviews-page">
    <div class="filter-outer reviews-page-title">
        <h1>{{ 'frontend.reviews'|trans([], 'CommentBundle') }}</h1>
    </div>

    <div class="page-list-comments">
        {% for comment in comments %}
            {{ item.pageComment(comment, settings.show_title) }}
        {% endfor %}
    </div>

    {% if settings.show_paginator and comments.getNbPages() > 1 %}
        {{ pagerfanta(comments, { 'omitFirstPage': true}) }}
    {% endif %}
</div>

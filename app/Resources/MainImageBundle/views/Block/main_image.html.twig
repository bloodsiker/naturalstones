{% if mainImage %}
    <div class="main-video-bg">
        <img class="main-video-img lazyload" data-src="{{ asset(mainImage.image.path) }}" src="" alt="{{ mainImage.title }}" />
        <video autoplay muted loop poster="{{ asset(mainImage.image.path) }}">
{#            <source src="{{ asset('bundles/app/video/sky.mp4') }}"></source>#}
{#            <source src="images/video/video.webm" type="video/webm"></source>#}
{#            <source src="images/video/video.ogv" type="video/ogg">#}
        </video>
    </div>
{% endif %}
<div class="main-video-content">
    <div class="inner">
        <div class="desc-logo"><img src="{{ asset('bundles/app/images/video-logo.png') }}" width="300px" alt=""></div>
        <h1 class="main-video-title">{{ 'frontend.homepage.hero_title'|trans([], 'AppBundle') }}</h1>
        <div class="desc">{{ 'frontend.homepage.hero_description'|trans([], 'AppBundle') }}</div>
        <div class="main-video-actions">
            <a href="{{ path('product_list', {'slug': 'braslety'}) }}">{{ 'frontend.homepage.hero_link_bracelets'|trans([], 'AppBundle') }}</a>
            <a href="{{ path('product_list', {'slug': 'kole'}) }}">{{ 'frontend.homepage.hero_link_chokers'|trans([], 'AppBundle') }}</a>
            <a href="{{ path('product_list', {'slug': 'podveski'}) }}">{{ 'frontend.homepage.hero_link_pendants'|trans([], 'AppBundle') }}</a>
            <a href="{{ path('product_list', {'slug': 'niti-oberegi'}) }}">{{ 'frontend.homepage.hero_link_threads'|trans([], 'AppBundle') }}</a>
        </div>
    </div>
</div>

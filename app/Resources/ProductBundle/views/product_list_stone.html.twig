
<!-- catalog-section -->
<section class="simple-section">
    <div class="container">

        {{
            sonata_block_render(
                { 'type': 'app.block.service.breadcrumb' }
            )
        }}

        <div class="stone-commercial-intro">
            <p>
                {{ 'frontend.stone_commercial.intro'|trans({'%STONE%': stone.name}, 'AppBundle') }}
            </p>
            <div class="stone-commercial-links">
                <a href="{{ path('product_list', {'slug': 'braslety', 'stone': stone.id}) }}">{{ 'frontend.stone_commercial.link_bracelets'|trans({'%STONE%': stone.name}, 'AppBundle') }}</a>
                <a href="{{ path('product_list', {'slug': 'podveski', 'stone': stone.id}) }}">{{ 'frontend.stone_commercial.link_pendants'|trans({'%STONE%': stone.name}, 'AppBundle') }}</a>
                <a href="{{ path('product_list', {'slug': 'kole', 'stone': stone.id}) }}">{{ 'frontend.stone_commercial.link_chokers'|trans({'%STONE%': stone.name}, 'AppBundle') }}</a>
            </div>
        </div>

        <style>
            .stone-commercial-intro {
                position: relative;
                overflow: hidden;
                max-width: 1060px;
                margin: 0 auto 34px;
                padding: 28px 34px;
                color: #3F3F3F;
                font-size: 17px;
                line-height: 1.58;
                text-align: center;
                background: linear-gradient(135deg, #fff 0%, #fff7f7 52%, #fbdfdf 100%);
                border: 1px solid #f4d4d4;
                border-radius: 8px;
                box-shadow: 0 10px 30px rgba(20, 9, 35, 0.07);
            }

            .stone-commercial-intro:before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(90deg, #f08383, #fbdfdf);
            }

            .stone-commercial-intro p {
                max-width: 920px;
                margin: 0 auto 22px;
            }

            .stone-commercial-links {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 10px;
            }

            .stone-commercial-links a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-height: 42px;
                padding: 0 20px;
                border: 1px solid #f08383;
                border-radius: 99px;
                background: #fff;
                color: #140923;
                font-weight: 600;
                box-shadow: 0 4px 14px rgba(240, 131, 131, 0.14);
                transition: all 0.2s ease-out;
            }

            .stone-commercial-links a:hover {
                background: #f08383;
                color: #fff;
                border-color: #f08383;
                box-shadow: 0 7px 18px rgba(240, 131, 131, 0.26);
                transform: translateY(-1px);
            }

            @media (max-width: 767px) {
                .stone-commercial-intro {
                    padding: 22px 18px;
                    font-size: 15px;
                    text-align: left;
                }

                .stone-commercial-links {
                    justify-content: flex-start;
                }

                .stone-commercial-links a {
                    width: 100%;
                }
            }
        </style>

        {{
            sonata_block_render(
                { 'type': 'product.block.list' },
                {
                    'items_count' : 20,
                    'page': app.request.get('page') ? app.request.get('page') : 1,
                    'stone': stone,
                    'title': 'frontend.stone_commercial.h1'|trans({'%STONE%': stone.name}, 'AppBundle'),
                    'show_paginator': true
                }
            )
        }}

        {% if stone.description %}
            <div class="product-description-container slice-this">
                <h2>{{ 'frontend.stone_commercial.about_title'|trans({'%STONE%': stone.name}, 'AppBundle') }}</h2>
                {{ stone.description|shortcode|raw }}
            </div>
        {% endif %}
    </div>
</section>

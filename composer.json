{
    "name": "natural-stones/jewerly",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "": "src/"
        },
        "classmap": [
            "app/AppKernel.php",
            "app/AppCache.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=7.4",
        "a2lix/translation-form-bundle": "^3.0",
        "babdev/pagerfanta-bundle": "^3.0",
        "beberlei/doctrineextensions": "^1.3",
        "cocur/slugify": "^4.0",
        "doctrine/common": "^3.0",
        "doctrine/doctrine-bundle": "^2.4",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.11",
        "friendsofsymfony/ckeditor-bundle": "^2.0",
        "imagine/imagine": "^1.3.2",
        "intervention/image": "^2.7",
        "jms/i18n-routing-bundle": "^3.0",
        "knplabs/doctrine-behaviors": "^2.6",
        "knplabs/knp-gaufrette-bundle": "^0.8",
        "lexik/translation-bundle": "^6.0",
        "liip/imagine-bundle": "^2.7",
        "monolog/monolog": "^2.0",
        "oneup/uploader-bundle": "^4.0",
        "pagerfanta/doctrine-orm-adapter": "*",
        "pagerfanta/twig": "*",
        "sensio/framework-extra-bundle": "^6.1",
        "sentry/sentry-symfony": "^4.4",
        "sonata-project/admin-bundle": "^4.0",
        "sonata-project/datagrid-bundle": "^3.0",
        "sonata-project/doctrine-orm-admin-bundle": "^4.0",
        "sonata-project/intl-bundle": "^2.5",
        "sonata-project/page-bundle": "^4.0",
        "sonata-project/user-bundle": "^5.0",
        "symfony/monolog-bundle": "^3.6",
        "symfony/polyfill-apcu": "^1.0",
        "symfony/symfony": "^5.4",
        "twig/twig": "^3.0",
        "vich/uploader-bundle": "^1.20"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^5.4"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony-app-dir": "app",
        "symfony-bin-dir": "bin",
        "symfony-var-dir": "var",
        "symfony-web-dir": "web",
        "symfony-tests-dir": "tests",
        "symfony-assets-install": "relative"
    }
}

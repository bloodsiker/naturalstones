{
    "name": "natural-stones/jewerly",
    "license": "proprietary",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Application\\Migrations\\": "migrations/",
            "": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "a2lix/translation-form-bundle": "^3.0",
        "babdev/pagerfanta-bundle": "^4.0",
        "beberlei/doctrineextensions": "^1.3",
        "cocur/slugify": "^4.0",
        "doctrine/annotations": "^2.0",
        "doctrine/common": "^3.0",
        "doctrine/doctrine-bundle": "^2.7",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.14",
        "egulias/email-validator": "^4.0",
        "friendsofsymfony/ckeditor-bundle": "^2.0",
        "imagine/imagine": "^1.3.2",
        "intervention/image": "^2.7",
        "knplabs/doctrine-behaviors": "^3.1",
        "knplabs/knp-gaufrette-bundle": "^0.8",
        "lexik/translation-bundle": "^6.0",
        "liip/imagine-bundle": "^2.7",
        "monolog/monolog": "^2.0|^3.0",
        "oneup/uploader-bundle": "^4.0",
        "pagerfanta/doctrine-orm-adapter": "^4.0",
        "pagerfanta/twig": "^4.0",
        "sonata-project/admin-bundle": "^4.0",
        "sonata-project/datagrid-bundle": "^3.0",
        "sonata-project/doctrine-orm-admin-bundle": "^4.0",
        "sonata-project/intl-bundle": "^2.5",
        "sonata-project/page-bundle": "^4.0",
        "sonata-project/user-bundle": "^5.0",
        "symfony/asset": "^6.4",
        "symfony/console": "^6.4",
        "symfony/doctrine-bridge": "^6.4",
        "symfony/dotenv": "^6.4",
        "symfony/expression-language": "^6.4",
        "symfony/form": "^6.4",
        "symfony/framework-bundle": "^6.4",
        "symfony/http-client": "^6.4",
        "symfony/intl": "^6.4",
        "symfony/mailer": "^6.4",
        "symfony/mime": "^6.4",
        "symfony/monolog-bundle": "^3.8",
        "symfony/password-hasher": "^6.4",
        "symfony/process": "^6.4",
        "symfony/property-access": "^6.4",
        "symfony/property-info": "^6.4",
        "symfony/runtime": "^6.4",
        "symfony/security-bundle": "^6.4",
        "symfony/serializer": "^6.4",
        "symfony/string": "^6.4",
        "symfony/templating": "^6.4",
        "symfony/translation": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/uid": "^6.4",
        "symfony/validator": "^6.4",
        "symfony/yaml": "^6.4",
        "twig/twig": "^3.0",
        "vich/uploader-bundle": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.4",
        "symfony/debug-bundle": "^6.4",
        "symfony/phpunit-bridge": "^6.4",
        "symfony/stopwatch": "^6.4",
        "symfony/web-profiler-bundle": "^6.4"
    },
    "scripts": {
        "app:cache-clear": "@php -d memory_limit=512M bin/console cache:clear --env=prod --no-debug --no-warmup",
        "app:assets-install": "@php bin/console assets:install --symlink --relative public"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        },
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^6.4"
        }
    }
}

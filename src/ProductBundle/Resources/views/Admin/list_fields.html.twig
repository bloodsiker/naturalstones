{% extends admin.templateRegistry.getTemplate('base_list_field') %}

{% block field %}
    {% if object is instanceof('\\ProductBundle\\Entity\\Product') %}
        {% if field_description.name == 'price' %}
            <p style="white-space: nowrap">
                <span class="text-muted info" style="font-size: 12px;">
                     {{ 'product.fields.price'|trans({}, 'ProductBundle') }}: <b>{{ object.price }}</b><br/>
                     {{ 'product.fields.discount'|trans({}, 'ProductBundle') }}: <b>{{ object.discount }}</b><br/>
                     {{ 'product.fields.percent'|trans({}, 'ProductBundle') }}: <b>{{ object.percent }}%</b><br/>
                </span>
            </p>
        {% elseif field_description.name == 'size' %}
            {% if object.size %}
                {% set route = field_description.options.route|default(null) %}
                {% if route and field_description.associationadmin %}
                    <a href="{{ field_description.associationadmin.generateObjectUrl(route.name, object.size, route.parameters|default({})) }}" class="label label-primary">{{ object.size }}</a>
                {% else %}
                    <span class="label label-primary">{{ object.size }}</span>
                {% endif %}
            {% endif %}
        {% elseif field_description.name == 'colours' %}
            {% set route = field_description.options.route|default(null) %}
            {% for colour in object.colours %}
                {% if route and field_description.associationadmin %}
                    <a href="{{ field_description.associationadmin.generateObjectUrl(route.name, colour, route.parameters|default({})) }}"><span class="colorpicker__preview" style="background-color: {{ '#' ~ colour.colour }}; margin: 0;"></span></a>
                {% else %}
                    <span class="colorpicker__preview" style="background-color: {{ '#' ~ colour.colour }}; margin: 0;"></span>
                {% endif %}
            {% endfor %}
        {% elseif field_description.name == 'name' %}
            <a href="{{ admin.generateUrl('edit', { id : object.id }) }}" class="sonata-link-identifier">{{ object.name }}</a>
        {% elseif field_description.name == 'image' %}
            {% set v = asset('bundles/admin/images/preview_placeholder.png') %}
            {% set image_preview_path = value ? value.path : null %}
            <img data-src="{{ image_preview_path|default(v) }}?{{ random() }}" src="" class="lazyload" style="max-height: 100px;"/>
        {% endif %}
    {% elseif object is instanceof('\\ProductBundle\\Entity\\ProductInfoView') %}

        {% if field_description.name == 'product' %}
            {% set route = field_description.options.route|default(null) %}
            {% set product_name = object.product.getName ~ ' ' ~ (object.product.size ? object.product.size.name : null) %}
            {% if route and field_description.associationadmin %}
                <a href="{{ field_description.associationadmin.generateObjectUrl(route.name, object.product, route.parameters|default({})) }}" class="sonata-link-identifier">{{ product_name }}</a>
            {% else %}
                <span class="sonata-link-identifier">{{ product_name }}</span>
            {% endif %}
        {% endif %}
    {% endif %}
{% endblock %}

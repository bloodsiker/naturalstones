{% extends '@SonataAdmin/CRUD/base_list.html.twig' %}

{% set filter_target = app.request.query.get('field_id') ?: admin.uniqid %}

{% block list_filters_actions %}
    {%- if admin.datagrid.filters|length %}
        <ul class="nav navbar-nav navbar-right">

            <li class="dropdown sonata-actions">
                <a href="#" class="dropdown-toggle sonata-ba-action" data-toggle="dropdown">
                    <i class="fas fa-filter" aria-hidden="true"></i>
                    {{ 'link_filters'|trans({}, 'SonataAdminBundle') }}
                    <span class="badge sonata-filter-count"></span>
                    <b class="caret"></b>
                </a>

                <ul class="dropdown-menu" role="menu">


                    {% for filter in admin.datagrid.filters %}
                        {% set filterCanBeDisplayed = filter.showFilter|default(filter.option('show_filter')) is not same as(false) %}
                        {% if filterCanBeDisplayed %}
                        {% set filterDisplayed = filter.isActive() or filter.showFilter|default(filter.option('show_filter')) is same as(true) %}
                        <li>
                            <a href="#" class="sonata-toggle-filter sonata-ba-action" filter-target="filter-{{ filter_target }}-{{ filter.name }}" filter-container="filter-container-{{ filter_target }}" onclick="if (event) { event.preventDefault(); event.stopPropagation(); if (event.stopImmediatePropagation) event.stopImmediatePropagation(); } var target=document.getElementById('{{ ('filter-' ~ filter_target ~ '-' ~ filter.name)|e('js') }}'); var container=document.getElementById('{{ ('filter-container-' ~ filter_target)|e('js') }}'); if (!target) return false; target.style.display='block'; target.hidden=false; if (container) { container.style.display='block'; container.hidden=false; } var scope=(container && container.closest('.modal')) || document; var links=scope.querySelectorAll('[filter-target=&quot;{{ ('filter-' ~ filter_target ~ '-' ~ filter.name)|e('html_attr') }}&quot;]'); for (var i=0; i<links.length; i++) { var icon=links[i].querySelector('i'); if (icon && !icon.classList.contains('fa-minus-circle')) { icon.classList.remove('fa-square'); icon.classList.add('fa-check-square'); links[i].classList.add('active'); } } return false;">
                                <i class="far {{ filterDisplayed ? 'fa-check-square' : 'fa-square' }}"></i>
                                {% if filter.label is not same as(false) %}
                                    {% if filter.translationDomain is same as(false) %}
                                        {{ filter.label }}
                                    {% else %}
                                        {{ filter.label|trans(filter.option('label_translation_parameters', {}), filter.translationDomain ?? admin.translationDomain) }}
                                    {% endif %}
                                {% endif %}
                            </a>
                        </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </li>
        </ul>
    {% endif -%}
{% endblock %}

{% block list_filters %}
    {% if admin.datagrid.filters %}
        {% form_theme form get_admin_template('filter', admin.code) %}

        <div class="col-xs-12 col-md-12 sonata-filters-box" style="display: {{ admin.datagrid.hasDisplayableFilters ? 'block' : 'none' }}" id="filter-container-{{ filter_target }}">
            <div class="box box-primary" >
                <div class="box-body">
                    <form class="sonata-filter-form form-horizontal {{ admin.isChild and 1 == admin.datagrid.filters|length ? 'hide' : '' }}" action="{{ admin.generateUrl('list') }}" method="GET" role="form">
                        {{ form_errors(form) }}

                        <div class="row">
                            <div class="col-sm-9">
                                {% set withAdvancedFilter = false %}
                                {% for filter in admin.datagrid.filters %}
                                    {% set filterDisplayed = filter.isActive() or filter.showFilter|default(filter.option('show_filter')) is same as(true) %}
                                    {% set filterCanBeDisplayed = filter.option('show_filter') is not same as(false) %}
                                    <div class="form-group {% block sonata_list_filter_group_class %}{% endblock %}" id="filter-{{ filter_target }}-{{ filter.name }}" sonata-filter="{{ filterCanBeDisplayed ? 'true' : 'false' }}" style="display: {% if filterDisplayed %}block{% else %}none{% endif %}">
                                        {% if filter.label is not same as(false) %}
                                            <label for="{{ form[filter.formName].children['value'].vars.id }}" class="col-sm-3 control-label">
                                                {% if filter.translationDomain is same as(false) %}
                                                    {{ filter.label }}
                                                {% else %}
                                                    {{ filter.label|trans(filter.option('label_translation_parameters', {}), filter.translationDomain ?? admin.translationDomain) }}
                                                {% endif %}
                                            </label>
                                        {% endif %}
                                        {% set attr = form[filter.formName].children['type'].vars.attr|default({}) %}

                                        <div class="col-sm-4 advanced-filter">
                                            {{ form_widget(form[filter.formName].children['type'], {'attr':  attr}) }}
                                        </div>

                                        <div class="col-sm-4">
                                            {{ form_widget(form[filter.formName].children['value']) }}
                                        </div>

                                        <div class="col-sm-1">
                                            <label class="control-label">
                                                <a href="#" class="sonata-ba-action" filter-target="filter-{{ filter_target }}-{{ filter.name }}" filter-container="filter-container-{{ filter_target }}" onclick="if (event) { event.preventDefault(); event.stopPropagation(); if (event.stopImmediatePropagation) event.stopImmediatePropagation(); } var target=document.getElementById('{{ ('filter-' ~ filter_target ~ '-' ~ filter.name)|e('js') }}'); var container=document.getElementById('{{ ('filter-container-' ~ filter_target)|e('js') }}'); if (!target) return false; target.style.display='none'; target.hidden=true; var scope=(container && container.closest('.modal')) || document; var links=scope.querySelectorAll('[filter-target=&quot;{{ ('filter-' ~ filter_target ~ '-' ~ filter.name)|e('html_attr') }}&quot;]'); for (var i=0; i<links.length; i++) { var icon=links[i].querySelector('i'); if (icon && !icon.classList.contains('fa-minus-circle')) { icon.classList.remove('fa-check-square'); icon.classList.add('fa-square'); links[i].classList.remove('active'); } } if (container) { var rows=container.querySelectorAll('[sonata-filter]'); var visible=false; for (var j=0; j<rows.length; j++) { if (rows[j].style.display !== 'none' && !rows[j].hidden) { visible=true; break; } } container.style.display=visible ? 'block' : 'none'; container.hidden=!visible; } return false;">
                                                    <i class="fas fa-minus-circle" aria-hidden="true"></i>
                                                </a>
                                            </label>
                                        </div>
                                    </div>

                                    {% if filter.option('advanced_filter') %}
                                        {% set withAdvancedFilter = true %}
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <div class="col-sm-3 text-center">
                                <input type="hidden" name="filter[_page]" id="filter__page" value="1">

                                {% set foo = form['_page'].setRendered() %}
                                {{ form_rest(form) }}

                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-filter" aria-hidden="true"></i> {{ 'btn_filter'|trans({}, 'SonataAdminBundle') }}
                                    </button>

                                    <a class="btn btn-default" href="{{ admin.generateUrl('list', {filters: 'reset'}) }}">
                                        {{ 'link_reset_filter'|trans({}, 'SonataAdminBundle') }}
                                    </a>
                                </div>

                                {% if withAdvancedFilter %}
                                    <div class="form-group">
                                        <a href="#" data-toggle="advanced-filter" onclick="if (event) { event.preventDefault(); event.stopPropagation(); if (event.stopImmediatePropagation) event.stopImmediatePropagation(); } var form=this.closest('form'); if (!form) return false; var fields=form.querySelectorAll('.advanced-filter'); for (var i=0; i<fields.length; i++) { var visible=fields[i].style.display !== 'none' && !fields[i].hidden; fields[i].style.display=visible ? 'none' : 'block'; fields[i].hidden=visible; } return false;">
                                            <i class="fas fa-cogs" aria-hidden="true"></i>
                                            {{ 'btn_advanced_filters'|trans({}, 'SonataAdminBundle') }}
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        {% for paramKey, paramValue in admin.persistentParameters %}
                            <input type="hidden" name="{{ paramKey }}" value="{{ paramValue }}">
                        {% endfor %}
                    </form>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

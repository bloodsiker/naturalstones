{% block series_admin_title_text_widget %}
    {{ block('form_widget') }}

    <script>
        var id = jQuery('#{{ form.vars.id }}');
        var label = jQuery('label[for={{ id }}]');
        label.after('<div id="duplicate_series" style="margin-bottom: 5px;max-height: 100px;overflow-y: scroll;"></div>');
        var container = jQuery('#duplicate_series');
        jQuery('#{{ id }}').on('input',function() {
            var name = $(this).val();
            if (name.length > 3) {
                jQuery.ajax({
                    method: "GET",
                    url: "{{ path('admin_series_series_search_series') }}",
                    cache: false,
                    dataType: 'json',
                    data: { 'name': name },
                    success: function (response) {
                        console.log(response);
                        if (response) {
                            var message = '';
                            for (var i in response) {
                                message += '<a href="'+ response[i].url +'" style="margin-right: 5px" target="_blank">' + response[i].name + '</a><br/>';
                            }
                            container.html(message);
                        }
                    }
                });
            } else {
                container.html('');
            }
        });
    </script>
{% endblock %}

{% block text_counter_widget %}
    {{ block('form_widget') }}
    {{ block('counter_widget') }}

    {% if attr['data-product-name-autocomplete']|default(false) %}
        <script>
            jQuery(function ($) {
                var $input = $('#{{ id }}');
                var pendingRequest = null;
                var requestTimer = null;
                var items = [];
                var activeIndex = -1;
                var isOpen = false;
                var suppressSearch = false;
                var requestSequence = 0;
                var fieldLocaleMatch = $input.attr('name').match(/\[translations]\[([^\]]+)]\[name]$/);
                var fieldLocale = fieldLocaleMatch ? fieldLocaleMatch[1] : '{{ app.request.locale|e('js') }}';
                var $dropdown = $('<div>', {
                    'class': 'dropdown-menu',
                    css: {
                        display: 'none',
                        position: 'fixed',
                        zIndex: 1060,
                        maxHeight: '260px',
                        overflowY: 'auto',
                        padding: 0
                    }
                });

                $input.after($dropdown);

                function positionDropdown() {
                    var rect = $input[0].getBoundingClientRect();
                    if (!rect) {
                        return;
                    }

                    $dropdown.css({
                        top: rect.bottom,
                        left: rect.left,
                        width: rect.width
                    });
                }

                function closeDropdown() {
                    isOpen = false;
                    activeIndex = -1;
                    items = [];
                    $dropdown.hide().empty();
                }

                function setActive(index) {
                    if (!items.length) {
                        activeIndex = -1;
                        return;
                    }

                    activeIndex = index;
                    var $items = $dropdown.find('[data-product-item]');
                    $items
                        .removeClass('active')
                        .css({
                            backgroundColor: '',
                            color: '#333'
                        });
                    if (index >= 0) {
                        var $activeItem = $items.eq(index)
                            .addClass('active')
                            .css({
                                backgroundColor: '#337ab7',
                                color: '#fff'
                            });
                        var itemTop = $activeItem.position().top;
                        var itemBottom = itemTop + $activeItem.outerHeight();
                        var dropdownScrollTop = $dropdown.scrollTop();
                        var dropdownHeight = $dropdown.innerHeight();

                        if (itemTop < 0) {
                            $dropdown.scrollTop(dropdownScrollTop + itemTop);
                        } else if (itemBottom > dropdownHeight) {
                            $dropdown.scrollTop(dropdownScrollTop + itemBottom - dropdownHeight);
                        }
                    }
                }

                function chooseItem(index) {
                    if (index < 0 || index >= items.length) {
                        return;
                    }

                    var selectedItem = items[index];
                    closeDropdown();
                    suppressSearch = true;
                    $input.val(selectedItem.value).trigger('change');
                    window.setTimeout(function () {
                        suppressSearch = false;
                    }, 0);
                }

                function renderDropdown(data) {
                    items = data || [];
                    activeIndex = -1;
                    $dropdown.empty();

                    if (!items.length) {
                        closeDropdown();
                        return;
                    }

                    items.forEach(function (item, index) {
                        var $item = $('<a>', {
                            href: '#',
                            'class': 'dropdown-item',
                            'data-product-item': '1',
                            text: item.label
                        });

                        $item.css({
                            display: 'block',
                            width: '100%',
                            padding: '6px 12px',
                            cursor: 'pointer',
                            textDecoration: 'none',
                            color: '#333'
                        });

                        $item.on('mouseenter', function () {
                            setActive(index);
                        });

                        $item.on('mousedown', function (event) {
                            event.preventDefault();
                            chooseItem(index);
                        });

                        $dropdown.append($item);
                    });

                    positionDropdown();
                    $dropdown.show();
                    isOpen = true;
                }

                function search(term) {
                    var currentRequestSequence = ++requestSequence;

                    if (pendingRequest) {
                        pendingRequest.abort();
                    }

                    pendingRequest = $.ajax({
                        url: '{{ path('product_name_autocomplete') }}',
                        dataType: 'json',
                        data: {
                            q: term,
                            locale: fieldLocale
                        }
                    }).done(function (data) {
                        if (currentRequestSequence !== requestSequence) {
                            return;
                        }

                        renderDropdown((data.items || []).map(function (item) {
                            return {
                                label: item.label,
                                value: item.value,
                                id: item.id
                            };
                        }));
                    }).fail(function (xhr, status) {
                        if ('abort' === status || currentRequestSequence !== requestSequence) {
                            return;
                        }

                        closeDropdown();
                    }).always(function () {
                        if (currentRequestSequence === requestSequence) {
                            pendingRequest = null;
                        }
                    });
                }

                $input.attr('autocomplete', 'off');

                $input.on('input', function () {
                    if (suppressSearch) {
                        return;
                    }

                    var term = $.trim($input.val());
                    if (requestTimer) {
                        clearTimeout(requestTimer);
                    }

                    if (term.length < 2) {
                        closeDropdown();
                        return;
                    }

                    requestTimer = setTimeout(function () {
                        search(term);
                    }, 250);
                });

                $input.on('keydown', function (event) {
                    if (!isOpen) {
                        return;
                    }

                    if (event.which === 40) {
                        event.preventDefault();
                        setActive(activeIndex >= items.length - 1 ? 0 : activeIndex + 1);
                    } else if (event.which === 38) {
                        event.preventDefault();
                        setActive(activeIndex <= 0 ? items.length - 1 : activeIndex - 1);
                    } else if (event.which === 13) {
                        event.preventDefault();
                        chooseItem(activeIndex < 0 ? 0 : activeIndex);
                    } else if (event.which === 27) {
                        event.preventDefault();
                        closeDropdown();
                    }
                });

                $input.on('blur', function () {
                    window.setTimeout(closeDropdown, 150);
                });

                $(window).on('resize scroll', function () {
                    if (isOpen) {
                        positionDropdown();
                    }
                });
                $(document).on('mousedown', function (event) {
                    if (!$(event.target).closest($dropdown).length && event.target !== $input[0]) {
                        closeDropdown();
                    }
                });
            });
        </script>
    {% endif %}
{% endblock %}

{% block textarea_counter_widget %}
    {{ block('textarea_widget') }}
    {{ block('counter_widget') }}
{% endblock %}

{% block counter_widget %}
    <script>
        $('#{{ id }}').textcounter({
            countContainerClass: 'text-count-wrapper pull-right',
            stopInputAtMaximum: {{ stop_at_maximum ? 'true' : 'false' }},
            counterText: '{{ ('admin.fields.counter.total.'~widget_type)|trans({}, 'SonataAdminBundle') }}: %d',
            countDownText: '{{ ('admin.fields.counter.remaining.'~widget_type)|trans({}, 'SonataAdminBundle') }}: %d',
            countSpaces: {{ count_spaces ? 'true' : 'false' }},
            countDown: {{ count_down ? 'true' : 'false' }},
            type: "{{ widget_type }}",
            min: {{ min }},
            max: {{ max }},
        });
    </script>
{% endblock %}

{% block codemirror_widget %}
    {% apply spaceless %}
        {{ block('textarea_widget') }}

        <script type="text/javascript">
            if (typeof CodeMirror !== 'undefined') {
                CodeMirror.fromTextArea(document.getElementById('{{ id }}'), {
                    autoRefresh: true,
                    lineNumbers: true,
                    mode: 'htmlmixed',
                    indentUnit: 4,
                    autofocus: true,
                    fixedGutter: true,
                    lineWrapping: true
                });
            }
        </script>
    {% endapply %}
{% endblock %}

{% set fieldName = 'get' ~ field_description.options.field %}
{% set value = attribute( object, fieldName, [{ 'locale': app.request.locale }] ) %}
{% if field_description.type == 'text' %}
    {% include '@SonataAdmin/CRUD/base_list_field.html.twig' with { 'value': value } %}
{% elseif field_description.type starts with 'orm_' %}
    {% include '@SonataDoctrineORMAdmin/CRUD/list_' ~ field_description.type ~ '.html.twig' with { 'value': value } %}
{% else %}
    {% include '@SonataAdmin/CRUD/list_' ~ field_description.type ~ '.html.twig' with { 'value': value } %}
{% endif %}

<section class="simple-section">
    <div class="container">

        <h1>{{ 'frontend.cabinet.title'|trans([], 'AppBundle') }}</h1>

        <div class="cabinet-layout">

            {{ include('@App/Cabinet/_sidebar.html.twig') }}

            <div class="cabinet-content">
                <div class="cabinet-card">
                    <div class="cabinet-card__title">{{ 'frontend.cabinet.addresses_title'|trans([], 'AppBundle') }}</div>

                    {% if error %}
                        <div class="cabinet-alert cabinet-alert--error">{{ error|trans([], 'AppBundle') }}</div>
                    {% endif %}

                    <form method="post" action="{{ path('cabinet_addresses') }}" class="cabinet-form">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('cabinet_addresses') }}">

                        <div class="cabinet-form__row">
                            <div class="cabinet-form__field">
                                <label class="cabinet-form__label" for="address_title">{{ 'frontend.cabinet.addresses.form.title'|trans([], 'AppBundle') }}</label>
                                <input class="cabinet-form__input" id="address_title" type="text" name="title" maxlength="120" placeholder="{{ 'frontend.cabinet.addresses.form.title_placeholder'|trans([], 'AppBundle') }}">
                            </div>
                            <div class="cabinet-form__field cabinet-form__field--checkbox">
                                <label class="cabinet-form__checkbox">
                                    <input type="checkbox" name="is_default" value="1">
                                    <span>{{ 'frontend.cabinet.addresses.form.default'|trans([], 'AppBundle') }}</span>
                                </label>
                            </div>
                        </div>

                        <div class="cabinet-form__field">
                            <label class="cabinet-form__label" for="address_value">{{ 'frontend.cabinet.addresses.form.address'|trans([], 'AppBundle') }}</label>
                            <textarea class="cabinet-form__input cabinet-form__textarea" id="address_value" name="address" rows="3" placeholder="{{ 'frontend.cabinet.addresses.form.address_placeholder'|trans([], 'AppBundle') }}"></textarea>
                        </div>

                        <button class="button cabinet-form__submit" type="submit">{{ 'frontend.cabinet.addresses.form.save'|trans([], 'AppBundle') }}</button>
                    </form>
                </div>

                <div class="cabinet-card cabinet-card--spaced">
                    <div class="cabinet-card__title">{{ 'frontend.cabinet.addresses.saved'|trans([], 'AppBundle') }}</div>

                    {% if addresses is empty %}
                        <div class="cabinet-empty">{{ 'frontend.cabinet.addresses.empty'|trans([], 'AppBundle') }}</div>
                    {% else %}
                        <div class="cabinet-address-list">
                            {% for address in addresses %}
                                <article class="cabinet-address-card{% if address.isDefault %} cabinet-address-card--default{% endif %}">
                                    <div class="cabinet-address-card__header">
                                        <div class="cabinet-address-card__title-row">
                                            <div class="cabinet-address-card__name">
                                                {{ address.title ?: ('frontend.cabinet.addresses.no_title'|trans([], 'AppBundle')) }}
                                            </div>
                                            {% if address.isDefault %}
                                                <span class="cabinet-address-card__badge">{{ 'frontend.cabinet.addresses.default_badge'|trans([], 'AppBundle') }}</span>
                                            {% endif %}
                                        </div>
                                        <div class="cabinet-address-card__text">{{ address.address }}</div>
                                    </div>
                                    <div class="cabinet-address-card__actions">
                                        {% if not address.isDefault %}
                                            <form method="post" action="{{ path('cabinet_address_default', {'id': address.id}) }}">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('cabinet_address_default_' ~ address.id) }}">
                                                <button type="submit" class="button white-button cabinet-address-card__button">
                                                    {{ 'frontend.cabinet.addresses.make_default'|trans([], 'AppBundle') }}
                                                </button>
                                            </form>
                                        {% endif %}
                                        <form method="post" action="{{ path('cabinet_address_delete', {'id': address.id}) }}">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('cabinet_address_delete_' ~ address.id) }}">
                                            <button type="submit" class="button cabinet-address-card__button cabinet-address-card__button--danger">
                                                {{ 'frontend.cabinet.addresses.delete'|trans([], 'AppBundle') }}
                                            </button>
                                        </form>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>

    </div>
</section>

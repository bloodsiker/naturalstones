<section class="simple-section">
    <div class="container">

        <h1>{{ 'frontend.cabinet.title'|trans([], 'AppBundle') }}</h1>

        <div class="cabinet-layout">

            {{ include('@App/Cabinet/_sidebar.html.twig') }}

            <div class="cabinet-content">
                <div class="cabinet-card">
                    <div class="cabinet-card__title">{{ 'frontend.cabinet.favorites_title'|trans([], 'AppBundle') }}</div>

                    {% if favorites is empty %}
                        <div class="cabinet-empty">{{ 'frontend.cabinet.no_favorites'|trans([], 'AppBundle') }}</div>
                    {% else %}
                        <div class="cabinet-favorites-grid">
                            {% for product in favorites %}
                                {% if product.isActive %}
                                <div class="cabinet-fav-item">
                                    <a href="{{ product_path(product) }}" class="cabinet-fav-item__image">
                                        <img src="{{ asset(product.image.path) }}" alt="{{ product.name }}">
                                    </a>
                                    <div class="cabinet-fav-item__info">
                                        <div class="cabinet-fav-item__category">{{ product.category.getName }}</div>
                                        <a href="{{ product_path(product) }}" class="cabinet-fav-item__name">{{ product.name }}</a>
                                        <div class="cabinet-fav-item__price">
                                            {% if product.discount %}
                                                <span class="cabinet-fav-item__price--old">{{ product.price }} грн</span>
                                                <span>{{ product.discount }} грн</span>
                                            {% else %}
                                                <span>{{ product.price }} грн</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <button class="product-favorite product-favorite--active cabinet-fav-item__remove"
                                            data-id="{{ product.id }}" type="button"
                                            title="{{ 'frontend.cabinet.favorites_remove'|trans([], 'AppBundle') }}">
                                        <svg width="18" height="18" viewBox="0 0 24 24">
                                            <path class="fav-heart" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                        </svg>
                                    </button>
                                </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>

    </div>
</section>
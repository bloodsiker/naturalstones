<!doctype html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>{{ company_name }} #{{ order.id }}</title>
</head>
<body style="margin:0;padding:0;background:#f8f4f4;font-family:Arial,Helvetica,sans-serif;color:#140923;">
    <table role="presentation" width="100%" style="width:100%;border-collapse:collapse;background:#f8f4f4;">
        <tr>
            <td align="center" style="padding:24px;">
                <table role="presentation" width="640" style="width:100%;max-width:640px;border-collapse:collapse;background:#ffffff;border:1px solid #f1d7d7;border-radius:16px;overflow:hidden;box-shadow:0 16px 36px rgba(20,9,35,.08);">
                    <tr>
                        <td>
            <table role="presentation" style="width:100%;border-collapse:collapse;background:#fff;border-bottom:1px solid #f1d7d7;">
                <tr>
                    <td style="width:36%;padding:16px 4px 16px 18px;text-align:right;vertical-align:middle;white-space:nowrap;">
                        <a href="{{ site_url }}/catalog/braslety" style="display:inline-block;margin-right:12px;color:#140923;font-size:12px;font-weight:700;text-decoration:none;">Браслети</a>
                        <a href="{{ site_url }}/catalog/nabory" style="display:inline-block;color:#140923;font-size:12px;font-weight:700;text-decoration:none;">Набори</a>
                    </td>
                    <td style="width:28%;padding:10px 8px;text-align:center;vertical-align:middle;">
                        <a href="{{ site_url }}" style="display:inline-block;text-decoration:none;">
                            <img src="{{ site_url }}/bundles/app/images/logo.jpg" width="72" height="72" alt="{{ company_name }}" style="display:block;width:72px;height:72px;border:0;border-radius:50%;">
                        </a>
                    </td>
                    <td style="width:36%;padding:16px 18px 16px 4px;text-align:left;vertical-align:middle;white-space:nowrap;">
                        <a href="{{ site_url }}/catalog/kole" style="display:inline-block;margin-right:12px;color:#140923;font-size:12px;font-weight:700;text-decoration:none;">Кольє</a>
                        <a href="{{ site_url }}/catalog/podveski" style="display:inline-block;color:#140923;font-size:12px;font-weight:700;text-decoration:none;">Підвіски</a>
                    </td>
                </tr>
            </table>
            <div style="padding:24px 28px;background:linear-gradient(180deg,#fff7f7 0%,#fff 100%);border-bottom:1px solid #f1d7d7;">
                <div style="font-size:14px;color:#f08383;font-weight:700;text-transform:uppercase;letter-spacing:.04em;">{{ company_name }}</div>
                <h1 style="margin:8px 0 0;font-size:24px;line-height:1.2;">Дякуємо за замовлення #{{ order.id }}</h1>
            </div>

            <div style="padding:24px 28px;">
                <div style="margin-bottom:18px;font-size:16px;line-height:1.5;">
                    Ваше замовлення прийнято в обробку. Нижче ми зібрали основні дані.
                </div>

                <table style="width:100%;border-collapse:collapse;font-size:15px;line-height:1.5;margin-bottom:24px;">
                    <tr>
                        <td style="padding:8px 0;color:#6b6b6b;width:40%;">Статус</td>
                        <td style="padding:8px 0;font-weight:700;">{{ order.getNameStatus(order.status)|trans({}, 'OrderBundle') }}</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0;color:#6b6b6b;">Сума замовлення</td>
                        <td style="padding:8px 0;font-weight:700;">{{ order.orderSum|number_format(2, ',', ' ') }} грн</td>
                    </tr>
                    {% if order.promoCode %}
                    <tr>
                        <td style="padding:8px 0;color:#6b6b6b;">Промокод</td>
                        <td style="padding:8px 0;font-weight:700;color:#27ae60;">{{ order.promoCode.code }} (-{{ order.discountPromo|number_format(2, ',', ' ') }} грн)</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0;color:#6b6b6b;">Разом до сплати</td>
                        <td style="padding:8px 0;font-weight:700;font-size:17px;">{{ order.totalSum|number_format(2, ',', ' ') }} грн</td>
                    </tr>
                    {% endif %}
                    {% if order.fio %}
                        <tr>
                            <td style="padding:8px 0;color:#6b6b6b;">Ім'я</td>
                            <td style="padding:8px 0;font-weight:700;">{{ order.fio }}</td>
                        </tr>
                    {% endif %}
                    {% if order.phone %}
                        <tr>
                            <td style="padding:8px 0;color:#6b6b6b;">Телефон</td>
                            <td style="padding:8px 0;font-weight:700;">{{ order.phone }}</td>
                        </tr>
                    {% endif %}
                    {% if order.address %}
                        <tr>
                            <td style="padding:8px 0;color:#6b6b6b;">Адреса доставки</td>
                            <td style="padding:8px 0;font-weight:700;">{{ order.address }}</td>
                        </tr>
                    {% endif %}
                    {% if order.spinPrize %}
                        <tr>
                            <td style="padding:8px 0;color:#6b6b6b;">Приз колеса</td>
                            <td style="padding:8px 0;font-weight:700;color:#f08383;">{{ order.spinPrize }}</td>
                        </tr>
                    {% endif %}
                </table>

                <div style="margin-bottom:24px;">
                    <a href="{{ site_url }}/order/{{ order.secret }}/success" style="display:inline-block;padding:12px 18px;border-radius:8px;background:#f08383;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;">
                        Переглянути замовлення
                    </a>
                </div>

                <div style="font-size:18px;font-weight:700;margin-bottom:14px;">Товари</div>
                {% for item in order.orderHasItems %}
                    <div style="padding:14px 16px;border:1px solid #f3e0e0;border-radius:14px;margin-bottom:10px;background:#fff;">
                        <table role="presentation" style="width:100%;border-collapse:collapse;">
                            <tr>
                                {% if item.product.image %}
                                    <td style="width:76px;padding-right:14px;vertical-align:top;">
                                        <img src="{{ site_url }}{{ item.product.image.path }}" width="76" height="76" alt="{{ item.product.name }}" style="display:block;width:76px;height:76px;border:0;border-radius:10px;object-fit:cover;">
                                    </td>
                                {% endif %}
                                <td style="vertical-align:top;">
                                    <div style="font-weight:700;margin-bottom:6px;">{{ item.product.name }}{% if item.product.size %} ({{ item.product.size }}){% endif %}</div>
                                    <div style="color:#6b6b6b;font-size:14px;">
                                        {{ item.quantity }} шт. - {{ item.price|number_format(2, ',', ' ') }} грн
                                        {% if item.options %}<br>{{ item.options|nl2br }}{% endif %}
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>
                {% endfor %}

                <div style="margin-top:22px;padding-top:16px;border-top:1px solid #f1d7d7;font-size:15px;color:#6b6b6b;">
                    З найкращими побажаннями,<br>
                    команда {{ company_name }}
                </div>
            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>

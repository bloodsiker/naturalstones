{% if products.count %}
    <div class="filter-outer">
        {% if settings.title_url %}
            <h1><a href="{{ settings.title_url }}">{{ settings.title }}</a></h1>
        {% else %}
            <h1>{{ settings.title }}</h1>
        {% endif %}

        {% if settings.filter %}
            {% include '@App/Block/filter.html.twig' %}
        {% endif %}
    </div>

    {% set selectedStones = app.request.get('stone') ? app.request.get('stone')|split(',') : [] %}
    {% set selectedColours = app.request.get('colour') ? app.request.get('colour')|split(',') : [] %}
    {% set selectedMinPrice = app.request.get('min_price') %}
    {% set selectedMaxPrice = app.request.get('max_price') %}
    {% set hasSelectedPrice = (selectedMinPrice and selectedMinPrice != minPrice) or (selectedMaxPrice and selectedMaxPrice != maxPrice) %}
    {% set hasSelectedFilters = selectedStones|length or selectedColours|length or hasSelectedPrice %}

    {% if hasSelectedFilters %}
        <div class="selected-filters">
            {% if selectedColours|length %}
                <div class="selected-filter-group selected-filter-group-colours">
                    <strong class="selected-filter-label">{{ app.request.locale == 'ru' ? 'Цвет' : 'Колір' }}:</strong>
                    <div class="selected-filter-group-items">
                        {% for colour in colours|default([]) %}
                            {% if colour.id in selectedColours %}
                                {% set remainingColours = selectedColours|filter(id => id != colour.id) %}
                                {% set query = app.request.query.all|filter((value, key) => key != 'colour' and key != 'page') %}
                                {% set query = remainingColours|length ? query|merge({'colour': remainingColours|join(',')}) : query %}
                                <a class="selected-filter" href="{{ app.request.pathinfo }}{{ query|length ? '?' ~ query|url_encode : '' }}">
                                    <span>{{ colour.name }}</span>
                                    <i aria-hidden="true"></i>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if selectedStones|length %}
                <div class="selected-filter-group selected-filter-group-stones">
                    <strong class="selected-filter-label">{{ app.request.locale == 'ru' ? 'Камни' : 'Каміння' }}:</strong>
                    <div class="selected-filter-group-items">
                        {% for stone in stones|default([]) %}
                            {% if stone.id in selectedStones %}
                                {% set remainingStones = selectedStones|filter(id => id != stone.id) %}
                                {% set query = app.request.query.all|filter((value, key) => key != 'stone' and key != 'page') %}
                                {% set query = remainingStones|length ? query|merge({'stone': remainingStones|join(',')}) : query %}
                                <a class="selected-filter" href="{{ app.request.pathinfo }}{{ query|length ? '?' ~ query|url_encode : '' }}">
                                    <span>{{ stone.name }}</span>
                                    <i aria-hidden="true"></i>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if hasSelectedPrice %}
                {% set query = app.request.query.all|filter((value, key) => key not in ['min_price', 'max_price', 'page']) %}
                <div class="selected-filter-group selected-filter-group-price">
                    <strong class="selected-filter-label">{{ app.request.locale == 'ru' ? 'Цена' : 'Ціна' }}:</strong>
                    <div class="selected-filter-group-items">
                        <a class="selected-filter" href="{{ app.request.pathinfo }}{{ query|length ? '?' ~ query|url_encode : '' }}">
                            <span>{{ selectedMinPrice ?: minPrice }} - {{ selectedMaxPrice ?: maxPrice }} грн</span>
                            <i aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    {% endif %}

    <div class="catalog-flex main-catalog">
        {% include '@Product/Block/large_list_ajax.html.twig' %}
    </div>

    {% if settings.ajax_paginator and products.hasNextPage %}
        {% set block_ajax_path = block.page is defined ? sonata_page_ajax_url(block) : block_ajax_url(block) %}
        <div class="more-catalog">
            <a href="#" class="more-catalog-link" id="get_more_products"
               data-route="{{ app.request.attributes.get('_route') }}"
               data-category="{{ settings.category.slug }}"
               data-next-page="{{  products.hasNextPage ? products.getNextPage : null }}"
               data-url="{{ block_ajax_path }}">
                <i><img src="{{ asset('bundles/app/images/rotate.svg') }}" alt="" /></i>
                <span>{{ 'frontend.load_more'|trans([], 'AppBundle') }}</span>
            </a>
        </div>
    {% endif %}

    <div class="pagination-container">
        {% include '@Product/Block/_pagination.html.twig' %}
    </div>
{% endif %}

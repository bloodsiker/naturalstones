
<!-- catalog-section -->
<section class="simple-section">
    <div class="container">

        {{
            sonata_block_render(
                { 'type': 'app.block.service.breadcrumb' }
            )
        }}

        {{
        sonata_block_render(
            { 'type': 'share.block.zodiac' },
            {
                'title' : 'frontend.stone_zodiac'|trans([], 'ShareBundle') ~ ' ' ~ zodiac.name,
                'mobile_select': true
            }
        )
        }}

        {{
            sonata_block_render(
                { 'type': 'share.block.stones' },
                {
                    'zodiac': zodiac
                }
            )
        }}

        {% if zodiac.stones|length %}
            {{
                sonata_block_render(
                    { 'type': 'product.block.list' },
                    {
                        'items_count': 20,
                        'page': app.request.get('page') ? app.request.get('page') : 1,
                        'stones': zodiac.stones|map(stone => stone.id),
                        'title': 'frontend.products_zodiac'|trans({'%ZODIAC%': zodiac.name}, 'ShareBundle'),
                        'show_paginator': true
                    }
                )
            }}
        {% endif %}
    </div>
</section>
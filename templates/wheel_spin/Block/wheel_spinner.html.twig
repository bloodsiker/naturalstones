
<div class="form-content" style="margin-bottom: 50px; margin-top: 70px">
    {% if order.isSpin %}
        <h4 class="wheel_title">{{ 'frontend.title_2'|trans([], 'WheelSpinBundle') }}</h4>
    {% else %}
        <h4 class="wheel_title">{{ 'frontend.title_3'|trans([], 'WheelSpinBundle') }}</h4>
    {% endif %}
</div>

<div class="order-form" style="margin-bottom: 70px">
    <div class="order-form-content">
        <div class="wheel_box">
            <canvas id="spinWheel"></canvas>
            <button id="spin_btn">Spin</button>
            <img src="{{ asset('bundles/app/images/spinner-arrow.svg') }}" id="spinnerArrow" alt="spinner-arrow" />
        </div>

    </div>
<div class="{{ settings.success_page|default(false) ? 'order-success-wheel' : 'order-form-total' }} wheel_container">
        <div class="top-block">
            <h4>{{ 'frontend.prizes'|trans([], 'WheelSpinBundle') }}</h4>
        </div>
        <div class="wheel_prize_container">
            {% for spinValue in spinValuesTable.WheelSpinHasOption %}
                {% set isWinner = order.isSpin and order.wheelSpinOption.id == spinValue.wheelSpinOption.id %}
                <div id="{{ spinValue.id }}"
                     class="wheel_prize {{ isWinner ? 'active' : '' }}">
                    {{ spinValue.label }}. {{ spinValue.wheelSpinOption.getPrizeName }}
                    {% if isWinner and order.spinPromoCode %}
                        <div class="wheel_prize_promo">
                            <span class="wheel_prize_promo__code">{{ order.spinPromoCode.code }}</span>
                            <span class="wheel_prize_promo__value">
                                {% if order.spinPromoCode.type == 'fixed' %}
                                    -{{ order.spinPromoCode.value }}грн
                                {% else %}
                                    -{{ order.spinPromoCode.value }}%
                                {% endif %}
                            </span>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>

<div id="wheelPrizeModal" class="popup-modal wheel-prize-modal mfp-hide mfp-with-anim">
    <div class="wheel-prize-modal__content">
        <div class="wheel-prize-modal__eyebrow">{{ 'frontend.modal.eyebrow'|trans([], 'WheelSpinBundle') }}</div>
        <h4>{{ 'frontend.modal.title'|trans([], 'WheelSpinBundle') }}</h4>
        <div id="wheelPrizeModalValue" class="wheel-prize-modal__value"></div>
        <p>{{ 'frontend.modal.description'|trans([], 'WheelSpinBundle') }}</p>
        <button type="button" class="button wheel-prize-modal__action">
            {{ 'frontend.modal.close'|trans([], 'WheelSpinBundle') }}
        </button>
    </div>
    <button class="mfp-close" type="button">
        <img src="{{ asset('bundles/app/images/cross.svg') }}" alt="">
    </button>
</div>

{% set block_ajax_path = block.page is defined ? sonata_page_ajax_url(block) : block_ajax_url(block) %}

{% block footer_javascripts %}
     <!---------------  Chart JS  --------------------->
     <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
     <!---------------  Chart JS Plugin  --------------------->
     <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.1.0/chartjs-plugin-datalabels.min.js"></script>

     <script>
         /* --------------- Spin Wheel  --------------------- */
         const spinWheel = document.getElementById("spinWheel");
         const spinBtn = document.getElementById("spin_btn");
         const wheelPrizeModalValue = document.getElementById("wheelPrizeModalValue");
         const wheelPrizeModalAction = document.querySelector(".wheel-prize-modal__action");
         let hasSpun = {{ order.isSpin ? 'true' : 'false' }};
         spinBtn.disabled = hasSpun;
         /* --------------- Minimum And Maximum Angle For A value  --------------------- */
         const spinValues = {{ spinValues|raw }};
         const spinValuesJson = {{ spinValuesJson|raw }};
         /* --------------- Pending promo code from server response  --------------------- */
         let pendingPromoCode = null;
         let pendingPromoLabel = null;
         /* --------------- Size Of Each Piece  --------------------- */
         const size = spinValues.map(item => item.size);
         /* --------------- Background Colors  --------------------- */
         const spinColors = spinValues.map(item => item.color);
         /* --------------- Chart --------------------- */
         /* --------------- Guide : https://chartjs-plugin-datalabels.netlify.app/guide/getting-started.html --------------------- */
         let spinChart = new Chart(spinWheel, {
             plugins: [ChartDataLabels],
             type: "pie",
             data: {
                 labels: spinValues.map(item => item.label),
                 datasets: [
                     {
                         backgroundColor: spinColors,
                         data: size,
                     },
                 ],
             },
             options: {
                 responsive: true,
                 animation: { duration: 0 },
                 plugins: {
                     tooltip: false,
                     legend: {
                         display: false,
                     },
                     datalabels: {
                         rotation: 90,
                         color: "#ffffff",
                         formatter: (_, context) => context.chart.data.labels[context.dataIndex],
                         font: { size: 24 },
                     },
                 },
             },
         });
         /* --------------- Display Value Based On The Angle --------------------- */
         const highlightingPrizes = (angleValue) => {
             for (let i of spinValuesJson) {
                 if (angleValue >= i.minDegree && angleValue <= i.maxDegree) {
                     clearStyle();
                     const prize = document.getElementById(i.id);
                     prize.style.backgroundColor = i.color;
                     prize.style.color = '#fff';
                     break;
                 }
             }
         }

         const generateValue = (angleValue) => {
             for (let i of spinValuesJson) {
                 if (angleValue >= i.minDegree && angleValue <= i.maxDegree) {
                     const prize = document.getElementById(i.id);
                     prize.classList.add("active");
                     return i;
                 }
             }

             return null;
         };

         const showPrizeModal = (prize) => {
             if (!prize) {
                 return;
             }

             if (pendingPromoCode) {
                 wheelPrizeModalValue.innerHTML =
                     '<p>Promocode: <strong>' + pendingPromoCode + '</strong></p>' +
                     '<p>Знижка: <strong>' + pendingPromoLabel.replace(/^-/, '') + '</strong></p>';
             } else {
                 wheelPrizeModalValue.textContent = prize.value;
             }

             window.jQuery.magnificPopup.open({
                 items: {
                     src: '#wheelPrizeModal',
                 },
                 removalDelay: 300,
                 fixedContentPos: true,
                 mainClass: 'mfp-zoom-in',
             });
         };

         wheelPrizeModalAction.addEventListener("click", () => {
             window.jQuery.magnificPopup.close();
         });

         const clearStyle = () => {
             const wheelPrizes = document.querySelectorAll('.wheel_prize');
             for (let i = 0; i < wheelPrizes.length; i++) {
                 wheelPrizes[i].removeAttribute('style');
             }
         }

         /* --------------- Spinning Code --------------------- */
         const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
         const animateSpin = (targetDegree) => {
             const startRotation = spinChart.options.rotation || 0;
             const extraRounds = 6;
             const endRotation = startRotation + (extraRounds * 360) + targetDegree;
             const duration = 6200;
             const startTime = performance.now();

             const step = (now) => {
                 const elapsed = now - startTime;
                 const progress = Math.min(elapsed / duration, 1);
                 const eased = easeOutCubic(progress);
                 const currentRotation = startRotation + ((endRotation - startRotation) * eased);

                 spinChart.options.rotation = currentRotation % 360;
                 spinChart.update();

                 if (progress < 1) {
                     requestAnimationFrame(step);
                     return;
                 }

                 spinChart.options.rotation = targetDegree;
                 spinChart.update();
                 const prize = generateValue(targetDegree);
                 setTimeout(() => showPrizeModal(prize), 1000);
             };

             requestAnimationFrame(step);
         };

         spinBtn.addEventListener("click", () => {
             if (hasSpun) {
                 return;
             }

             spinBtn.disabled = true;

             window.jQuery.ajax({
                 type: 'POST',
                 url: '{{ block_ajax_path }}',
                 data: { order_id: '{{ order.id }}' },
                 success: function (response) {
                     if (!response || typeof response.spin === 'undefined') {
                         spinBtn.disabled = hasSpun;
                         return;
                     }

                     if (response.promoCode) {
                         pendingPromoCode = response.promoCode;
                         pendingPromoLabel = response.promoLabel;
                     }

                     hasSpun = true;
                     animateSpin(response.spin);
                 },
                 error: function (xhr) {
                     if (xhr.status === 409) {
                         hasSpun = true;
                     }

                     spinBtn.disabled = hasSpun;
                 }
             });
         });
         /* --------------- End Spin Wheel  --------------------- */
     </script>
{% endblock %}